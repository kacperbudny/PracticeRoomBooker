{
  "name": "@booker/backend",
  "packageManager": "yarn@3.6.4",
  "types": "types/fastify.d.ts",
  "scripts": {
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "dev": "ts-node-dev --project tsconfig.json -r tsconfig-paths/register ./src/api/api.ts",
    "migrate": "ts-node --project tsconfig.json -r tsconfig-paths/register ./src/persistence/migrate.ts",
    "migrate:gen": "yarn migrate:gen --",
    "migrate:gen:private": "drizzle-kit generate --name $1"
  },
  "dependencies": {
    "@booker/common": "1.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/passport": "^2.5.0",
    "@fastify/secure-session": "^7.5.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.24.3",
    "fastify-type-provider-zod": "latest",
    "passport-local": "^1.0.0",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.9.1",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "drizzle-kit": "^0.24.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
